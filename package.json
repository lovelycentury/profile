{
  "name": "@okkly/profile",
  "version": "0.0.0",
  "private": true,
  "description": "Personal profile site — Next.js App Router, server-side rendered, i18n via next-intl",
  "scripts": {
    "dev": "next dev --port 5200",
    "build": "next build",
    "start": "next start --port 5200",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commit": "gitmoji --commit",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.3",
    "@number-flow/react": "^0.6.2",
    "@okkly/design-system": "^0.1.0",
    "@okkly/react": "^0.1.0",
    "next": "^16.3.0",
    "next-intl": "^4.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "gitmoji-cli": "^9.7.0",
    "oxlint": "1.77.0",
    "prettier": "^3.4.2",
    "sass-embedded": "^1.83.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.7.2"
  },
  "simple-git-hooks": {
    "commit-msg": "node tools/check-commit-msg.mjs $1"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
